{
  "version": 2,
  "builds": [
    {
      "src": "client/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://assamedchem-assignment.onrender.com/api/$1"
    },
    {
      "src": "/((?!api/).*)",
      "dest": "/client/index.html"
    }
  ]
}
